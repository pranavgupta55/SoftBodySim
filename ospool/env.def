Bootstrap: docker
From: python:3.13-slim

# SoftBodySim chunk_evolve image for the OSPool (build on the AP: apptainer build --ignore-proot softbody-py313-v1.sif env.def).
# Base: python:3.13-slim (CHANGE from the runbook's verified python:3.12-slim) to match the laptop's Python 3.13.7;
# all four pins have cp313 manylinux x86_64 wheels (checked 2026-10-29), so pip needs no compiler and no apt packages.
# The same pins also exist for cp312: to fall back to the verified base, change only the From: line.
# Versions = the laptop .venv (numpy 2.5.4, numba 0.68.0 + its llvmlite 0.50.0, pygame 2.6.1). pygame's wheel bundles
# SDL2 / SDL_ttf / freetype; it runs headless with the dummy SDL drivers below.
# Docker-verified 2026-10-29 (linux/amd64 under emulation, non-root, HOME=/srv, the ospool_files.txt set flat in cwd):
# a 1-round ospool_evolve run exited 0 with numba JIT on, and gave the same numbers as the laptop run.
# The python:3.13-slim tag floats (it gave Python 3.13.18); the built, versioned .sif freezes it.

%post
    pip install --no-cache-dir numpy==2.5.4 numba==0.68.0 llvmlite==0.50.0 pygame==2.6.1

%environment
    # Defaults only; run.sh / ospool_evolve.py set these too (Apptainer %environment is not verified on the OSPool).
    export SDL_VIDEODRIVER=dummy
    export SDL_AUDIODRIVER=dummy
    export PYGAME_HIDE_SUPPORT_PROMPT=1
    # NUMBA_CACHE_DIR: solver_jit uses @njit(cache=True), which writes next to solver_jit.py (__pycache__ in the job's
    # scratch cwd, writable) and falls back to $HOME (/srv, writable). Either way the cache is per job and starts
    # cold, so every job compiles once per worker process. Set it per job in run.sh, not here (cwd varies):
    #   export NUMBA_CACHE_DIR="$PWD/numba_cache"
    # Don't ship a laptop cache: it's keyed by the source files' paths/mtimes and the CPU, so it would never match.
